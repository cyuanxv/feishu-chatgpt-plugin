    "check:site-health": "node scripts/check-site-health.mjs"
  },
  "devDependencies": {
    "@larksuiteoapi/node-sdk": "1.74.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "26.6.4",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "zod": "4.6.5"
